# caches are small and committed on purpose -- they are the expensive artefact
!cache/*.npz
hf-cache/
logs/
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.DS_Store

# transient resume checkpoints written by 01_cache.py; the finished .npz is committed
cache/*.partial.npz

# local dumps / secrets
DEEPSEEK_PACK.txt
.env
*.pem
